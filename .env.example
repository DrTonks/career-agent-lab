# Copy to .env locally. Never commit credentials.
CAREER_API_KEY=
CAREER_BASE_URL=https://api.deepseek.com
CAREER_MODEL=deepseek-flash
# Same review policy for both architectures; off is an explicit ablation.
CAREER_FINAL_REVIEW=model
# Optional DeepSeek beta request mode; local validation remains mandatory.
# Real diagnostics still found missing required fields; this is not a guarantee.
CAREER_REVIEW_TRANSPORT=chat-tools
CAREER_REVIEW_UNITS_PER_PART=16
CAREER_REVIEW_SOURCE_TOKENS=8000
CAREER_EMBEDDING_MODE=local
CAREER_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
CAREER_LOCAL_EMBEDDING_REVISION=75c43b069aac4d136ba6bc1122f995fedcfd2781
CAREER_EMBEDDING_LOCAL_ONLY=false
CAREER_EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
CAREER_EMBEDDING_DOCUMENT_PREFIX=
# Explicit opt-in to paid live calls; use CLI --live with these settings.
CAREER_MAX_CALLS=60
# Increase per-expert tool/model turns for complete business tasks when needed.
CAREER_MAX_EXPERT_TURNS=10
CAREER_MAX_PLANNING_TURNS=12
CAREER_MAX_INPUT_TOKENS=600000
CAREER_MAX_OUTPUT_TOKENS=80000
# Reservation is inside those totals; same policy for both architectures.
CAREER_FINAL_RESERVE_CALLS=24
CAREER_FINAL_RESERVE_INPUT_TOKENS=240000
CAREER_FINAL_RESERVE_OUTPUT_TOKENS=32768
CAREER_MAX_CONTEXT_TOKENS=48000
CAREER_ACTIVE_CONTEXT_TARGET=22000
CAREER_MAX_RESPONSE_TOKENS=4096
CAREER_REQUEST_TIMEOUT_MS=90000
CAREER_MAX_RUN_MS=900000
